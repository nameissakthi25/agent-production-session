# Copy to .env and edit. Nothing here is a secret for a local run.

# --- the model -------------------------------------------------------------
# Any OpenAI-compatible endpoint. A vLLM server on the same box:
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=not-used
MODEL_NAME=Qwen/Qwen3.8-27B-FP8

TEMPERATURE=0.2
MAX_TOKENS=600

# --- tracing ---------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=chainlit-support-bot
# How the BROWSER reaches Phoenix, for the link under each answer.
PHOENIX_PUBLIC_URL=http://localhost:6006
TRACING_ENABLED=true

# --- guards ----------------------------------------------------------------
# local = the regex/phrase rules in this repo, no network, always works
# hub   = Guardrails AI DetectPII + NSFWText, installed separately
GUARD_VALIDATOR=local
MAX_INPUT_CHARS=4000

FEEDBACK_PATH=feedback.jsonl
