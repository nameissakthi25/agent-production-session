# Copy to .env and edit. Nothing here is a secret for a local run.

# --- the model -------------------------------------------------------------
# Any OpenAI-compatible endpoint. From a container, a server on your host is
# reachable as host.docker.internal.
OPENAI_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=not-used
# Whatever the server reports at /v1/models -- NOT necessarily the checkpoint
# name. vLLM serves under --served-model-name, and a mismatch is a 404.
MODEL_NAME=qwen3

# --- retrieval -------------------------------------------------------------
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=it-support-agent
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
TOP_K=4
# Measured, not guessed. See README section 4 and ingest/measure_floor.py.
SCORE_FLOOR=0.65

# --- tracing ---------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6008/v1/traces
PHOENIX_PROJECT_NAME=agent-support-bot
# How the BROWSER reaches Phoenix. In Docker this differs from the collector
# endpoint above, and setting them the same silently breaks one half.
PHOENIX_PUBLIC_URL=http://localhost:6007
TRACING_ENABLED=true

# --- guards ----------------------------------------------------------------
# guardrails = Guardrails AI over Presidio, plus the regex rules. The default.
# local      = the regex rules only.
GUARD_VALIDATOR=guardrails
MAX_INPUT_CHARS=4000
